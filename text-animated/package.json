{
  "name": "pancarte",
  "productName": "Pancarte",
  "version": "1.0.0",
  "description": "Texte animé sur fond transparent, par-dessus ton écran, pour tes streams Discord.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
