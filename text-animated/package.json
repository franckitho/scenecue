    "@fontsource/bungee": "^5.0.0",
    "@fontsource/bungee-shade": "^5.0.0",
    "@fontsource/caveat": "^5.0.0",
    "@fontsource/dela-gothic-one": "^5.0.0",
    "@fontsource/fredoka": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/lilita-one": "^5.0.0",
    "@fontsource/lobster": "^5.0.0",
